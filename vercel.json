{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "framework": "vite",
      "entrypoint": ".",
      "routePrefix": "/"
    }
  },
  "functions": {
    "api/leads/webhook-evolution.js": {
      "maxDuration": 60
    },
    "api/cron/verificar-vencimentos.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/verificar-vencimentos",
      "schedule": "0 11 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
