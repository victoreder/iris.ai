{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/leads/webhook-evolution.js": {
      "maxDuration": 60
    },
    "api/cron/verificar-vencimentos.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/verificar-vencimentos",
      "schedule": "0 11 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
