# Copie para .env na raiz do repositório

# Frontend (Vite build + go-redirect.js)
VITE_BACKEND_URL=http://localhost:3333

# Backend
PORT=3333
# URL HTTPS pública da API (webhook Evolution: {BACKEND_PUBLIC_URL}/api/leads/webhook-evolution)
BACKEND_PUBLIC_URL=http://localhost:3333

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Opcional Vercel go: rewrite /l/:slug → GET {VITE_BACKEND_URL}/api/leads/redirecionar?slug=:slug
