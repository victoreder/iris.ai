# Copie para .env na raiz do repositório (sem espaços após o =)

# Frontend (Vite)
VITE_APP_PUBLIC_URL=https://app.viziom.ia.br
VITE_BACKEND_URL=https://app.viziom.ia.br
VITE_GO_URL=https://go.viziom.ia.br
# Link público para compartilhar QR WhatsApp (sem login)
VITE_QR_PUBLIC_URL=https://qrcode.dominio.com.br
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# URL pública do bucket MinIO (ex.: https://minio2.seudominio.com.br/viziom)
VITE_S3_PUBLIC_URL=

# Meta / Facebook Login (integração CAPI nas configurações)
VITE_META_APP_ID=
# Opcional: config_id do Login for Business (Meta Developer → Facebook Login → Configurations)
VITE_META_LOGIN_CONFIG_ID=
# URI OAuth exata — cadastrar igual no Meta Developer (Facebook Login → URIs de redirecionamento OAuth)
VITE_META_OAUTH_REDIRECT_URI=http://localhost:5175/auth/meta/callback
META_OAUTH_REDIRECT_URI=http://localhost:5175/auth/meta/callback
# Produção (Vercel): https://app.viziom.ia.br/auth/meta/callback
META_APP_ID=
META_APP_SECRET=

# Backend (mesmo .env — rode: npm run dev:api)
PORT=3333
BACKEND_PUBLIC_URL=http://localhost:3333
QR_PUBLIC_URL=https://qrcode.dominio.com.br

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# MinIO / S3 — mídias WhatsApp, avatars e anexos (credenciais só no .env / Vercel, nunca no código)
S3_ENDPOINT=https://minio2.seudominio.com.br
S3_BUCKET=viziom
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# URL pública para leitura no browser (ex.: https://minio2.seudominio.com.br/viziom)
S3_PUBLIC_URL=

# Cron diário: POST /api/cron/verificar-vencimentos (header X-Cron-Secret)
CRON_SECRET=

# E-mail transacional (SMTP) — boas-vindas, vencimento amanhã, plano alterado
# SMTP_ENABLED=false desliga envios sem remover variáveis
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Viziom <noreply@seudominio.com>
APP_PUBLIC_URL=https://app.viziom.ia.br

# Preview temporário dos templates de e-mail: GET /api/dev/preview-email
# Local: aberto sem secret. Vercel: defina EMAIL_PREVIEW_SECRET e use ?secret=
EMAIL_PREVIEW_SECRET=

# Supabase Auth → URL Configuration: inclua redirects
# https://app.viziom.ia.br/auth/convite e http://localhost:5175/auth/convite
# https://app.viziom.ia.br/auth/redefinir-senha e http://localhost:5175/auth/redefinir-senha

# Deploy monolito na Vercel: app + go + /api/* (serverless)
# VITE_BACKEND_URL e BACKEND_PUBLIC_URL = mesma URL do deploy (ex. https://app.seudominio.com)
# Cron diário: /api/cron/verificar-vencimentos (Vercel envia GET com Authorization: Bearer CRON_SECRET)
